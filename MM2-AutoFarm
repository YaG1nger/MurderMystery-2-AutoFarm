updatePlayerList = function()
    for _, child in ipairs(scrollingList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local playerList = Players:GetPlayers()
    table.sort(playerList, function(a, b)
        if a == LocalPlayer then return false end
        if b == LocalPlayer then return true end
        local aIsFriend = LocalPlayer:IsFriendsWith(a.UserId)
        local bIsFriend = LocalPlayer:IsFriendsWith(b.UserId)
        if aIsFriend and not bIsFriend then return true end
        if not aIsFriend and bIsFriend then return false end
        return a.Name < b.Name
    end)

    for _, player in ipairs(playerList) do
        if player ~= LocalPlayer then
            local isFriend = LocalPlayer:IsFriendsWith(player.UserId)
            local isMurd = isPlayerMurderer(player)

            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, 0, 0, 28)
            
            if selectedPartners[player] then
                pBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 100)
            elseif isFriend then
                pBtn.BackgroundColor3 = Color3.fromRGB(60, 90, 130)
            else
                pBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
            end

            pBtn.Text = (isFriend and "⭐ " or "") .. player.Name .. (isMurd and selectedPartners[player] and " [Murderer]" or "")
            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.Font = Enum.Font.GothamMedium
            pBtn.TextSize = 11
            pBtn.Parent = scrollingList

            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 4)
            btnCorner.Parent = pBtn

            pBtn.MouseButton1Click:Connect(function()
                if selectedPartners[player] then
                    clearPartnerCoinVisuals(player)
                    selectedPartners[player] = nil
                    if partnerHighlights[player] then
                        partnerHighlights[player]:Destroy()
                        partnerHighlights[player] = nil
                    end
                else
                    selectedPartners[player] = player
                end

                local hasPartners = false
                for _, _ in pairs(selectedPartners) do
                    hasPartners = true
                    break
                end

                if hasPartners then
                    autoResetEnabled = true
                    safeZoneEnabled = true
                    autoResetBoxFill.BackgroundColor3 = Color3.fromRGB(80, 220, 120)
                    safeZoneBoxFill.BackgroundColor3 = Color3.fromRGB(80, 220, 120)
                else
                    autoResetEnabled = false
                    safeZoneEnabled = false
                    autoResetBoxFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    safeZoneBoxFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                end

                updatePartnerHighlights()
                updatePlayerList()
                updateActivePartnerPanel()
            end)
        end
    end
end

