local function updatePartnerBeams()
    for _, data in pairs(partnerBeams) do
        pcall(function()
            if data.beam then data.beam:Destroy() end
            if data.att0 then data.att0:Destroy() end
            if data.att1 then data.att1:Destroy() end
        end)
    end
    partnerBeams = {}

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    local activePartnerList = {}
    for _, partner in pairs(selectedPartners) do
        if partner and partner.Character and partner.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(activePartnerList, partner)
        end
    end

    if root then
        for _, partner in ipairs(activePartnerList) do
            local pRoot = partner.Character.HumanoidRootPart
            local att0, att1, beam = createBeam(root, pRoot, Color3.fromRGB(160, 50, 255))
            if beam then
                table.insert(partnerBeams, {att0 = att0, att1 = att1, beam = beam})
            end
        end
    end

    for i = 1, #activePartnerList do
        for j = i + 1, #activePartnerList do
            local p1Root = activePartnerList[i].Character.HumanoidRootPart
            local p2Root = activePartnerList[j].Character.HumanoidRootPart
            local att0, att1, beam = createBeam(p1Root, p2Root, Color3.fromRGB(160, 50, 255))
            if beam then
                table.insert(partnerBeams, {att0 = att0, att1 = att1, beam = beam})
            end
        end
    end
end

