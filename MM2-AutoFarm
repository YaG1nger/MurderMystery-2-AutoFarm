local function isCoinDisappearing(coinVisual)
    if not coinVisual or not coinVisual.Parent then return true end
    if coinVisual:IsA("BasePart") then
        if coinVisual.Transparency > 0.5 or coinVisual.Size.Magnitude < 0.5 then
            return true
        end
    end
    return false
end

-- Перевірка відстані монети до мардера (тримаємося на відстані близько 50 студій)
local function isCoinNearMurderer(coinPos)
    local murderers = getMurderersList()
    if #murderers == 0 then return false end

    for _, player in ipairs(murderers) do
        if not selectedPartners[player] and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local mRoot = player.Character.HumanoidRootPart
            if (coinPos - mRoot.Position).Magnitude < 50 then
                return true
            end
        end
    end
    return false
end

local function calculatePartnerPredictions()
    for _, partner in pairs(selectedPartners) do
        if partner and partner.Character and partner.Character:FindFirstChild("HumanoidRootPart") then
            local pRoot = partner.Character.HumanoidRootPart
            local closestCoin = nil
            local shortestDist = 80

            for _, child in ipairs(Workspace:GetChildren()) do
                if not ignoredNames[child.Name] and child:IsA("Model") then
                    local coinContainer = child:FindFirstChild("CoinContainer")
                    if coinContainer then
                        for _, coinServer in ipairs(coinContainer:GetChildren()) do
                            if coinServer.Name == "Coin_Server" then
                                local coinVisual = coinServer:FindFirstChild("CoinVisual")
                                if coinVisual and not isCoinDisappearing(coinVisual) then
                                    local dist = (pRoot.Position - coinVisual.Position).Magnitude
                                    if dist < shortestDist then
                                        shortestDist = dist
                                        closestCoin = coinVisual
                                    end
                                end
                            end
                        end
                    end
                end
            end

            if closestCoin then
                partnerTargetCoins[partner] = closestCoin
                
                if not partnerCoinHighlights[partner] or partnerCoinHighlights[partner].Parent ~= closestCoin then
                    if partnerCoinHighlights[partner] then partnerCoinHighlights[partner]:Destroy() end
                    local hl = Instance.new("Highlight")
                    hl.Name = "PartnerTargetCoinHL"
                    hl.FillColor = Color3.fromRGB(255, 170, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.3
                    hl.OutlineTransparency = 0
                    hl.Parent = closestCoin
                    partnerCoinHighlights[partner] = hl
                end

                if partnerCoinBeams[partner] then
                    local data = partnerCoinBeams[partner]
                    pcall(function()
                        if data.beam then data.beam:Destroy() end
                        if data.att0 then data.att0:Destroy() end
                        if data.att1 then data.att1:Destroy() end
                    end)
                    partnerCoinBeams[partner] = nil
                end

                local att0, att1, beam = createBeam(pRoot, closestCoin, Color3.fromRGB(255, 170, 0))
                if beam then
                    partnerCoinBeams[partner] = {att0 = att0, att1 = att1, beam = beam}
                end
            else
                clearPartnerCoinVisuals(partner)
            end
        else
            clearPartnerCoinVisuals(partner)
        end
    end
end

local function getClosestCoin()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPart = character.HumanoidRootPart

    local closestCoin = nil
    local shortestDistance = 1000

    local forbiddenCoins = {}
    for _, coinVis in pairs(partnerTargetCoins) do
        if coinVis then forbiddenCoins[coinVis] = true end
    end

    local foundAnyCoinOnMap = false

    for _, child in ipairs(Workspace:GetChildren()) do
        if not ignoredNames[child.Name] and child:IsA("Model") then
            local coinContainer = child:FindFirstChild("CoinContainer")
            if coinContainer then
                for _, coinServer in ipairs(coinContainer:GetChildren()) do
                    if coinServer.Name == "Coin_Server" then
                        local coinVisual = coinServer:FindFirstChild("CoinVisual")
                        if coinVisual and not isCoinDisappearing(coinVisual) then
                            foundAnyCoinOnMap = true
                            if not ignoredCoins[coinServer] and not forbiddenCoins[coinVisual] then
                                if not isCoinNearMurderer(coinVisual.Position) then
                                    local dist = (rootPart.Position - coinVisual.Position).Magnitude
                                    if dist < shortestDistance then
                                        shortestDistance = dist
                                        closestCoin = coinVisual
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if foundAnyCoinOnMap and not roundCoinsSpawned then
        roundCoinsSpawned = true
        hasCountedCurrentRound = false
    end

    return closestCoin
end

local function getCoinBagsContainer()
    local mainGui = PlayerGui:FindFirstChild("MainGUI")
    if not mainGui then return nil end

    local success, res = pcall(function()
        return mainGui.Game.CoinBags.Container
    end)
    if success and res then return res end

    success, res = pcall(function()
        return mainGui.Lobby.Dock.CoinBags.Container
    end)
    if success and res then return res end

    return nil
end

local function getRealGameCoins()
    local total = 0
    pcall(function()
        local container = getCoinBagsContainer()
        if not container then return end

        for _, itemFolder in ipairs(container:GetChildren()) do
            local currencyFrame = itemFolder:FindFirstChild("CurrencyFrame")
            if currencyFrame then
                local icon = currencyFrame:FindFirstChild("Icon")
                local coinsObj = (icon and icon:FindFirstChild("Coins")) or currencyFrame:FindFirstChild("Coins")
                
                if coinsObj then
                    local textValue = ""
                    if coinsObj:IsA("TextLabel") or coinsObj:IsA("TextBox") then
                        textValue = coinsObj.Text
                    else
                        local label = coinsObj:FindFirstChildWhichIsA("TextLabel", true)
                        if label then textValue = label.Text end
                    end
                    local num = tonumber(textValue)
                    if num then total = total + num end
                end
            end
        end
    end)
    return total
end

local function isBagFull()
    local full = false
    pcall(function()
        local container = getCoinBagsContainer()
        if container then
            for _, bagItem in ipairs(container:GetChildren()) do
                local fullIcon = bagItem:FindFirstChild("FullBagIcon", true)
                if fullIcon and fullIcon.Visible then
                    full = true
                    break
                end
            end
        end
    end)
    return full
end

local function checkAndUpdateCoinsOnTouch()
    local newCoins = getRealGameCoins()
    
    if newCoins > previousCoinsValue then
        local added = newCoins - previousCoinsValue
        sessionCoinsCollected = sessionCoinsCollected + added
        currentMatchCoins = newCoins
        previousCoinsValue = newCoins

        if currentMatchCoins > maxMatchCoins then
            maxMatchCoins = currentMatchCoins
        end

        if not isTimerRunning then
            isTimerRunning = true
            sessionStartTime = tick()
        end

        local elapsed = tick() - sessionStartTime
        if elapsed > 0.1 and sessionCoinsCollected > 0 then
            coinsPerHour = math.floor((sessionCoinsCollected / elapsed) * 3600)
        end
    elseif newCoins < previousCoinsValue then
        if roundCoinsSpawned and not hasCountedCurrentRound then
            failedBagAttempts = failedBagAttempts + 1
            hasCountedCurrentRound = true
        end

        roundCoinsSpawned = false
        currentMatchCoins = newCoins
        previousCoinsValue = newCoins
        hasReachedLimit = false
    end

    if isBagFull() and not hasReachedLimit then
        hasReachedLimit = true

        if not hasCountedCurrentRound then
            successfulFullBags = successfulFullBags + 1
            hasCountedCurrentRound = true
        end

        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")

        local hasPartners = false
        for _, _ in pairs(selectedPartners) do
            hasPartners = true
            break
        end

        if hasPartners then
            if safeZoneEnabled and root then
                currentFarmStatus = "Waiting for Partner"
                if notifySettings.partner.bagFullWait then
                    sendNotification("Coin Bag Full Waiting For Partner")
                end
                
                task.spawn(function()
                    local successTeleport = false
                    while not successTeleport and isAutoFarmActive do
                        successTeleport = teleportToRandomSpawn()
                        if not successTeleport then
                            task.wait(0.1)
                        end
                    end

                    if successTeleport then
                        task.wait(0.5)

                        while isAutoFarmActive and safeZoneEnabled do
                            local allReady = true
                            local characterRoot = character and character:FindFirstChild("HumanoidRootPart")

                            for _, partner in pairs(selectedPartners) do
                                if partner and partner.Character and partner.Character:FindFirstChild("HumanoidRootPart") and characterRoot then
                                    local partnerRoot = partner.Character.HumanoidRootPart
                                    local dist = (characterRoot.Position - partnerRoot.Position).Magnitude
                                    
                                    if dist > 100 then
                                        allReady = false
                                        break
                                    end
                                else
                                    allReady = false
                                end
                            end

                            if allReady then
                                if notifySettings.partner.allPartnersFullReset then
                                    sendNotification("All Partners are full Reseting...")
                                end
                                task.wait(0.3)
                                if character and character:FindFirstChild("Humanoid") then
                                    character:BreakJoints()
                                end
                                break
                            end
                            task.wait(0.5)
                        end
                    end
                end)
            end
        else
            currentFarmStatus = "Waiting for Coins"
            if autoResetEnabled and character then
                if notifySettings.solo.bagFullReset then
                    sendNotification("Coin Bag Full Reseting...")
                end
                root.Anchored = false
                character:BreakJoints()
            elseif safeZoneEnabled then
                if notifySettings.solo.safeZoneTeleport then
                    sendNotification("Coin Bag Full Teleporting to Safe Zone")
                end
                teleportToRandomSpawn()
            end
        end
    end
end

local function stopAutoFarm()
    isAutoFarmActive = false
    coinsPerHour = 0
    isTimerRunning = false
    sessionStartTime = nil
    hasReachedLimit = false
    speedWarningSent = false
    currentFarmStatus = "Idle"
    
    removeAntiAfk()
    removeAntiFling()
    removeCoinBeam()
    
    for partner, _ in pairs(selectedPartners) do
        clearPartnerCoinVisuals(partner)
    end
    
    pcall(function()
        Workspace.FallenPartsDestroyHeight = -500
    end)
    
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    clearActiveHighlight()
    setCharacterAnimations(true)
    
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        character.HumanoidRootPart.Anchored = false
    end
end

local function startAutoFarm()
    setupAntiAfk()
    setupAntiFling()
    updateTrackingPlatform(true)
    
    lastObservedGameCoins = getRealGameCoins()
    currentMatchCoins = lastObservedGameCoins
    sessionCoinsCollected = 0
    isTimerRunning = false
    sessionStartTime = nil
    hasReachedLimit = false
    speedWarningSent = false

    pcall(function()
        Workspace.FallenPartsDestroyHeight = 0/0
    end)

    task.spawn(function()
        while isAutoFarmActive do
            calculatePartnerPredictions()

            local hasPartners = false
            for _, _ in pairs(selectedPartners) do
                hasPartners = true
                break
            end

            if isBagFull() then
                if hasPartners then
                    currentFarmStatus = "Waiting for Partner"
                else
                    currentFarmStatus = "Waiting for Coins"
                end
                removeCoinBeam()
                task.wait(0.5)
                continue
            end

            local character = LocalPlayer.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then
                currentFarmStatus = "Waiting for Coins"
                removeCoinBeam()
                task.wait(0.2)
                continue
            end
            local rootPart = character.HumanoidRootPart
            rootPart.Anchored = false

            local targetCoinVisual = getClosestCoin()

            if targetCoinVisual and targetCoinVisual:IsDescendantOf(Workspace) then
                currentFarmStatus = "Moving to Coin"
                local parentCoinServer = targetCoinVisual.Parent
                if parentCoinServer then
                    ignoredCoins[parentCoinServer] = true
                    task.delay(3, function() ignoredCoins[parentCoinServer] = nil end)
                end

                clearActiveHighlight()
                activeHighlight = Instance.new("Highlight")
                activeHighlight.Name = "TargetCoinHighlight"
                activeHighlight.FillColor = Color3.fromRGB(0, 255, 255)
                activeHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                activeHighlight.FillTransparency = 0.2
                activeHighlight.OutlineTransparency = 0
                activeHighlight.Parent = targetCoinVisual

                coinBeamAttachment0, coinBeamAttachment1, coinBeam = createBeam(rootPart, targetCoinVisual, Color3.fromRGB(0, 255, 255))

                local targetCFrame = CFrame.new(targetCoinVisual.Position)
                local distance = (rootPart.Position - targetCFrame.Position).Magnitude
                local duration = distance / flySpeed
                local currentRotation = rootPart.CFrame - rootPart.Position

                setCharacterAnimations(false)

                local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
                currentTween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame * currentRotation})
                currentTween:Play()

                local flightStartTime = tick()
                local maxFlightDuration = duration + 2.5

                currentFarmStatus = "Collecting Coin"
                while currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing do
                    calculatePartnerPredictions()
                    rootPart.Anchored = false

                    if (tick() - flightStartTime) > maxFlightDuration then
                        currentTween:Cancel()
                        currentTween = nil
                        break
                    end

                    if not targetCoinVisual or not targetCoinVisual:IsDescendantOf(Workspace) or isCoinDisappearing(targetCoinVisual) or not isAutoFarmActive then
                        currentTween:Cancel()
                        currentTween = nil
                        break
                    end

                    if isCoinNearMurderer(targetCoinVisual.Position) then
                        currentTween:Cancel()
                        currentTween = nil
                        break
                    end

                    local betterCoin = getClosestCoin()
                    if betterCoin and betterCoin ~= targetCoinVisual then
                        local currentDist = (rootPart.Position - targetCoinVisual.Position).Magnitude
                        local newDist = (rootPart.Position - betterCoin.Position).Magnitude
                        if newDist < currentDist - 2 then
                            currentTween:Cancel()
                            currentTween = nil
                            break
                        end
                    end
                    task.wait(0.03)
                end

                removeCoinBeam()
                setCharacterAnimations(true)
                checkAndUpdateCoinsOnTouch()
                clearActiveHighlight()
            else
                currentFarmStatus = "Waiting for Coins"
                removeCoinBeam()
                rootPart.Anchored = false
                setCharacterAnimations(true)
                task.wait(0.2)
            end
        end

        removeCoinBeam()
        updateTrackingPlatform(false)
        pcall(function()
            Workspace.FallenPartsDestroyHeight = -500
        end)

        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            character.HumanoidRootPart.Anchored = false
        end
        clearActiveHighlight()
        setCharacterAnimations(true)
    end)
end

