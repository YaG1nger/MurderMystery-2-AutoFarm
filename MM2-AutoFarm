local function isCoinDisappearing(coinVisual)
    if not coinVisual or not coinVisual.Parent then return true end
    if coinVisual:IsA("BasePart") then
        if coinVisual.Transparency > 0.5 or coinVisual.Size.Magnitude < 0.5 then
            return true
        end
    end
    return false
end

local function getKnifeThreatOffset(rootPart)
    local threatOffset = Vector3.new(0, 0, 0)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local enemyChar = player.Character
            local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")
            if enemyRoot then
                local hasKnife = false
                for _, item in ipairs(enemyChar:GetChildren()) do
                    if item:IsA("Tool") and item.Name:lower():find("knife") then
                        hasKnife = true
                        break
                    end
                end
                if hasKnife then
                    local dist = (rootPart.Position - enemyRoot.Position).Magnitude
                    if dist < 25 then
                        local pushDir = (rootPart.Position - enemyRoot.Position).Unit
                        threatOffset = threatOffset + (pushDir * 12)
                    end
                end
            end
        end
    end
    return threatOffset
end

local function isAnyCoinClose(rootPart)
    for _, child in ipairs(Workspace:GetChildren()) do
        if not ignoredNames[child.Name] and child:IsA("Model") then
            local coinContainer = child:FindFirstChild("CoinContainer")
            if coinContainer then
                for _, coinServer in ipairs(coinContainer:GetChildren()) do
                    if coinServer.Name == "Coin_Server" then
                        local coinVisual = coinServer:FindFirstChild("CoinVisual")
                        if coinVisual and not isCoinDisappearing(coinVisual) then
                            local dist = (rootPart.Position - coinVisual.Position).Magnitude
                            if dist <= 10 then
                                return true
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

local function getClosestCoin()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local rootPart = character.HumanoidRootPart

    local closestCoin = nil
    local shortestDistance = 1000

    for _, child in ipairs(Workspace:GetChildren()) do
        if not ignoredNames[child.Name] and child:IsA("Model") then
            local coinContainer = child:FindFirstChild("CoinContainer")
            if coinContainer then
                for _, coinServer in ipairs(coinContainer:GetChildren()) do
                    if coinServer.Name == "Coin_Server" then
                        local coinVisual = coinServer:FindFirstChild("CoinVisual")
                        if coinVisual and not ignoredCoins[coinServer] and not isCoinDisappearing(coinVisual) then
                            local dist = (rootPart.Position - coinVisual.Position).Magnitude
                            if dist < shortestDistance then
                                shortestDistance = dist
                                closestCoin = coinVisual
                            end
                        end
                    end
                end
            end
        end
    end

    return closestCoin
end

local function getRealGameCoins()
    local total = 0
    pcall(function()
        local mainGui = PlayerGui:FindFirstChild("MainGUI")
        if not mainGui then return end
        local gameGui = mainGui:FindFirstChild("Game")
        if not gameGui then return end
        local coinBags = gameGui:FindFirstChild("CoinBags")
        if not coinBags then return end
        local container = coinBags:FindFirstChild("Container")
        if not container then return end

        for _, itemFolder in ipairs(container:GetChildren()) do
            local currencyFrame = itemFolder:FindFirstChild("CurrencyFrame")
            if currencyFrame then
                local icon = currencyFrame:FindFirstChild("Icon")
                local coinsObj = (icon and icon:FindFirstChild("Coins")) or currencyFrame:FindFirstChild("Coins")
                
                if coinsObj then
                    local textValue = ""
                    if coinsObj:IsA("TextLabel") or coinsObj:IsA("TextBox") then
                        textValue = coinsObj.Text
                    else
                        local label = coinsObj:FindFirstChildWhichIsA("TextLabel", true)
                        if label then textValue = label.Text end
                    end
                    local num = tonumber(textValue)
                    if num then total = total + num end
                end
            end
        end
    end)
    return total
end

local function areCoinsLeftOnMap()
    local found = false
    pcall(function()
        for _, child in ipairs(Workspace:GetChildren()) do
            if not ignoredNames[child.Name] and child:IsA("Model") then
                local coinContainer = child:FindFirstChild("CoinContainer")
                if coinContainer then
                    for _, coinServer in ipairs(coinContainer:GetChildren()) do
                        if coinServer.Name == "Coin_Server" then
                            local coinVisual = coinServer:FindFirstChild("CoinVisual")
                            if coinVisual and not isCoinDisappearing(coinVisual) then
                                found = true
                                break
                            end
                        end
                    end
                end
            end
            if found then break end
        end
    end)
    return found
end

local function checkAndUpdateCoinsOnTouch()
    local newCoins = getRealGameCoins()
    
    if newCoins > previousCoinsValue then
        local added = newCoins - previousCoinsValue
        sessionCoinsCollected = sessionCoinsCollected + added
        currentMatchCoins = newCoins
        previousCoinsValue = newCoins

        if not isTimerRunning then
            isTimerRunning = true
            sessionStartTime = tick()
        end

        local elapsed = tick() - sessionStartTime
        if elapsed > 0.1 and sessionCoinsCollected > 0 then
            coinsPerHour = math.floor((sessionCoinsCollected / elapsed) * 3600)
        end

        if currentMatchCoins >= 40 and not areCoinsLeftOnMap() and not hasReachedLimit then
            hasReachedLimit = true
            maxMatchCoins = currentMatchCoins
            local character = LocalPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")

            if safeZoneEnabled and root then
                createSafeZone()
                root.CFrame = getSafeZoneTeleportCFrame()

                task.spawn(function()
                    while isAutoFarmActive and safeZoneEnabled do
                        local allPartnersReady = true
                        local platformPos = safeZonePart and safeZonePart.Position or Vector3.new(0, 10000, 0)

                        for _, partner in pairs(selectedPartners) do
                            if partner and partner.Character and partner.Character:FindFirstChild("HumanoidRootPart") then
                                local partnerRoot = partner.Character.HumanoidRootPart
                                local dist = (platformPos - partnerRoot.Position).Magnitude
                                if dist > 100 then
                                    allPartnersReady = false
                                    break
                                end
                            else
                                allPartnersReady = true
                            end
                        end

                        if allPartnersReady then
                            task.wait(0.5)
                            if character and character:FindFirstChild("Humanoid") then
                                character:BreakJoints()
                            end
                            break
                        end
                        task.wait(1)
                    end
                end)
            elseif autoResetEnabled and character then
                character:BreakJoints()
            end
        end
    elseif newCoins < previousCoinsValue then
        if currentMatchCoins > 0 then
            maxMatchCoins = currentMatchCoins
        end
        currentMatchCoins = newCoins
        previousCoinsValue = newCoins
        hasReachedLimit = false
    end
end

local function stopAutoFarm()
    isAutoFarmActive = false
    coinsPerHour = 0
    isTimerRunning = false
    sessionStartTime = nil
    hasReachedLimit = false
    
    removeAntiAfk()
    
    local hasPartners = false
    for _, _ in pairs(selectedPartners) do
        hasPartners = true
        break
    end
    if not hasPartners then
        removeSafeZonePlatform()
    end
    
    pcall(function()
        Workspace.FallenPartsDestroyHeight = -500
    end)
    
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    clearActiveHighlight()
    setCharacterAnimations(true)
    
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        character.HumanoidRootPart.Anchored = false
    end
end

local function startAutoFarm()
    setupAntiAfk()
    
    lastObservedGameCoins = getRealGameCoins()
    currentMatchCoins = lastObservedGameCoins
    sessionCoinsCollected = 0
    isTimerRunning = false
    sessionStartTime = nil
    hasReachedLimit = false

    pcall(function()
        Workspace.FallenPartsDestroyHeight = 0/0
    end)

    task.spawn(function()
        while isAutoFarmActive do
            local character = LocalPlayer.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then
                task.wait(0.2)
                continue
            end
            local rootPart = character.HumanoidRootPart

            local targetCoinVisual = getClosestCoin()

            if targetCoinVisual and targetCoinVisual:IsDescendantOf(Workspace) then
                local parentCoinServer = targetCoinVisual.Parent
                if parentCoinServer then
                    ignoredCoins[parentCoinServer] = true
                    task.delay(3, function() ignoredCoins[parentCoinServer] = nil end)
                end

                if not isAnyCoinClose(rootPart) then
                    rootPart.Anchored = true
                end

                clearActiveHighlight()
                activeHighlight = Instance.new("Highlight")
                activeHighlight.Name = "TargetCoinHighlight"
                activeHighlight.FillColor = Color3.fromRGB(0, 255, 255)
                activeHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                activeHighlight.FillTransparency = 0.2
                activeHighlight.OutlineTransparency = 0
                activeHighlight.Parent = targetCoinVisual

                local threatOffset = getKnifeThreatOffset(rootPart)
                local targetCFrame = CFrame.new(targetCoinVisual.Position + threatOffset)

                local distance = (rootPart.Position - targetCFrame.Position).Magnitude
                local duration = distance / flySpeed
                local currentRotation = rootPart.CFrame - rootPart.Position

                setCharacterAnimations(false)

                local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
                currentTween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame * currentRotation})
                currentTween:Play()

                while currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing do
                    if isAnyCoinClose(rootPart) then
                        rootPart.Anchored = false
                    else
                        rootPart.Anchored = true
                    end

                    local betterCoin = getClosestCoin()
                    if betterCoin and betterCoin ~= targetCoinVisual then
                        local currentDist = (rootPart.Position - targetCoinVisual.Position).Magnitude
                        local newDist = (rootPart.Position - betterCoin.Position).Magnitude
                        if newDist < currentDist - 2 then
                            currentTween:Cancel()
                            currentTween = nil
                            break
                        end
                    end

                    if not targetCoinVisual or not targetCoinVisual:IsDescendantOf(Workspace) or isCoinDisappearing(targetCoinVisual) or not isAutoFarmActive then
                        currentTween:Cancel()
                        currentTween = nil
                        break
                    end
                    task.wait(0.03)
                end

                setCharacterAnimations(true)
                checkAndUpdateCoinsOnTouch()
                clearActiveHighlight()
            else
                rootPart.Anchored = false
                setCharacterAnimations(true)
                task.wait(0.2)
            end
        end

        local hasPartners = false
        for _, _ in pairs(selectedPartners) do
            hasPartners = true
            break
        end
        if not hasPartners then
            removeSafeZonePlatform()
        end

        pcall(function()
            Workspace.FallenPartsDestroyHeight = -500
        end)

        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            character.HumanoidRootPart.Anchored = false
        end
        clearActiveHighlight()
        setCharacterAnimations(true)
    end)
end

