local function teleportToRandomSpawn()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return false end
    local rootPart = character.HumanoidRootPart

    local attempts = 0
    while rootPart.Anchored and attempts < 5 do
        rootPart.Anchored = false
        task.wait(0.05)
        attempts = attempts + 1
    end

    if rootPart.Anchored then
        return false
    end

    local spawnsFolder = Workspace:FindFirstChild("Lobby") and Workspace.Lobby:FindFirstChild("Spawns")
    if spawnsFolder then
        local spawnsList = {}
        for _, child in ipairs(spawnsFolder:GetChildren()) do
            if child:IsA("BasePart") then
                table.insert(spawnsList, child)
            end
        end

        if #spawnsList > 0 then
            local randomSpawn = spawnsList[math.random(1, #spawnsList)]
            rootPart.CFrame = randomSpawn.CFrame + Vector3.new(0, 3, 0)
            print("[MM2 Debug Action] Телепортація до випадкового спавну успішна.")
            return true
        else
            rootPart.CFrame = CFrame.new(0, 100, 0)
            return true
        end
    end
    return false
end

