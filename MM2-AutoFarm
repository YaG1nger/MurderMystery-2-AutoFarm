            distLabel.BackgroundTransparency = 1
            distLabel.Text = "N/A"
            distLabel.TextColor3 = Color3.fromRGB(160, 50, 255)
            distLabel.Font = Enum.Font.GothamBold
            distLabel.TextSize = 10
            distLabel.Parent = card

            task.spawn(function()
                while card and card.Parent and selectedPartners[partner] do
                    if partner and partner.Character and partner.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local d = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - partner.Character.HumanoidRootPart.Position).Magnitude)
