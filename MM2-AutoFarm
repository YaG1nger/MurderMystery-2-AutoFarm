-- Функція створення Beam з захистом від дублювання
local function createBeam(part0, part1, color)
    local existingBeams = {}
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Beam") then
            table.insert(existingBeams, obj)
        end
    end
    
    if #existingBeams >= 2 then
        local beamToRemove = existingBeams[math.random(1, #existingBeams)]
        if beamToRemove then
            if beamToRemove.Attachment0 then beamToRemove.Attachment0:Destroy() end
            if beamToRemove.Attachment1 then beamToRemove.Attachment1:Destroy() end
            beamToRemove:Destroy()
            print("[MM2 Debug Action] Видалено зайвий дубльований Beam.")
        end
    end

    local att0 = Instance.new("Attachment", part0)
    local att1 = Instance.new("Attachment", part1)
    
    local beam = Instance.new("Beam")
    beam.Attachment0 = att0
    beam.Attachment1 = att1
    beam.Color = ColorSequence.new(color)
    beam.Width0 = 0.25
    beam.Width1 = 0.25
    beam.FaceCamera = true
    beam.Transparency = NumberSequence.new(0.2)
    beam.Parent = Workspace
    
    return att0, att1, beam
end

