local function createBeam(part0, part1, color)
    if not part0 or not part1 or not part0.Parent or not part1.Parent then return nil, nil, nil end

    local existingBeams = {}
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Beam") then
            table.insert(existingBeams, obj)
        end
    end
    
    if #existingBeams >= 4 then
        local beamToRemove = existingBeams[math.random(1, #existingBeams)]
        if beamToRemove then
            pcall(function()
                if beamToRemove.Attachment0 then beamToRemove.Attachment0:Destroy() end
                if beamToRemove.Attachment1 then beamToRemove.Attachment1:Destroy() end
                beamToRemove:Destroy()
            end)
        end
    end

    local att0, att1, beam
    pcall(function()
        att0 = Instance.new("Attachment", part0)
        att1 = Instance.new("Attachment", part1)
        
        beam = Instance.new("Beam")
        beam.Attachment0 = att0
        beam.Attachment1 = att1
        beam.Color = ColorSequence.new(color)
        beam.Width0 = 0.25
        beam.Width1 = 0.25
        beam.FaceCamera = true
        beam.Transparency = NumberSequence.new(0.2)
        beam.Parent = Workspace
    end)
    
    return att0, att1, beam
end

