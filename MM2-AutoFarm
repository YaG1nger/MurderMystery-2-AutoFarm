            totalCollectedLabel.Text = "Total collected: 0"
            partnerLabel.Text = "Partners: 0"
            timerLabel.Text = "Time: 00:00"
            statusLabel.Text = "Status: Idle"
        end
        task.wait(1)
    end
end)

local isDraggingSlider = false

local function updateSlider(input)
    local minSpeed = 10
    local maxSpeed = 30
    local posX = math.clamp(input.Position.X - sliderBackground.AbsolutePosition.X, 0, sliderBackground.AbsoluteSize.X)
    local scale = posX / sliderBackground.AbsoluteSize.X
    
    flySpeed = math.floor(minSpeed + scale * (maxSpeed - minSpeed))
    
    if flySpeed > 22 then
        speedLabel.Text = "Flight Speed: " .. flySpeed .. "⚠️"
        speedWarningLabel.Text = "Speed above 22 May kick you from the game"
    else
        speedLabel.Text = "Flight Speed: " .. flySpeed
        speedWarningLabel.Text = ""
    end

    sliderFill.Size = UDim2.new(scale, 0, 1, 0)
end

sliderBackground.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSlider = true
        dragging = false
        updateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSlider = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input)
    end
end)
