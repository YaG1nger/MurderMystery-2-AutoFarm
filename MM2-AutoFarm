local function formatTimer(totalSeconds)
    local days = math.floor(totalSeconds / 86400)
    local hours = math.floor((totalSeconds % 86400) / 3600)
    local minutes = math.floor((totalSeconds % 3600) / 60)
    local seconds = math.floor(totalSeconds % 60)

    if days > 0 then
        return string.format("%dd %02d:%02d:%02d", days, hours, minutes, seconds)
    else
        return string.format("%02d:%02d:%02d", hours, minutes, seconds)
    end
end

sdfSuccessLabel.RichText = true
sdfFailLabel.RichText = true

task.spawn(function()
    while true do
        local totalAttempts = successfulFullBags + failedBagAttempts
        local ratePercent = 0
        if totalAttempts > 0 then
            ratePercent = math.floor((successfulFullBags / totalAttempts) * 100)
        end

        sdfSuccessLabel.Text = "Full Bags (Success): <font color=\"rgb(80,220,120)\">" .. successfulFullBags .. "</font>"
        sdfFailLabel.Text = "Failed Runs: <font color=\"rgb(255,100,100)\">" .. failedBagAttempts .. "</font>"

        local formattedRateText = string.format("Success Rate: %d%% (<font color=\"rgb(255,100,100)\">%d</font>/<font color=\"rgb(80,220,120)\">%d</font>)", ratePercent, failedBagAttempts, successfulFullBags)

        if isAutoFarmActive then
            statsLabel.Text = "Speed: " .. coinsPerHour .. "/h"
            roundCollectedLabel.Text = "Coins per round: " .. currentMatchCoins .. "/" .. maxMatchCoins
            totalCollectedLabel.Text = "Total collected: " .. sessionCoinsCollected
            successRateLabel.Text = formattedRateText
            statusLabel.Text = "Status: " .. currentFarmStatus
            
            local count = 0
            for _, _ in pairs(selectedPartners) do
                count = count + 1
            end
            activePartnerBtn.Text = "Partners: " .. count .. " (Click to View)"
            
            if isTimerRunning and sessionStartTime then
                local elapsed = tick() - sessionStartTime
                timerLabel.Text = "Time: " .. formatTimer(elapsed)
            else
                timerLabel.Text = "Time: Waiting..."
            end
        else
            statsLabel.Text = "Speed: 0/h"
            roundCollectedLabel.Text = "Coins per round: 0/0"
            totalCollectedLabel.Text = "Total collected: 0"
            successRateLabel.Text = formattedRateText
            activePartnerBtn.Text = "Partners: 0"
            timerLabel.Text = "Time: 00:00:00"
            statusLabel.Text = "Status: Idle"
        end
        task.wait(1)
    end
end)

local isDraggingSlider = false

local function updateSlider(input)
    local minSpeed = 10
    local maxSpeed = 30
    local posX = math.clamp(input.Position.X - sliderBackground.AbsolutePosition.X, 0, sliderBackground.AbsoluteSize.X)
    local scale = posX / sliderBackground.AbsoluteSize.X
    
    flySpeed = math.floor(minSpeed + scale * (maxSpeed - minSpeed))
    
    if flySpeed > 22 then
        speedLabel.Text = "Flight Speed: " .. flySpeed .. "⚠️"
        speedWarningLabel.Text = "Speed above 22 May kick you from the game"
        if not speedWarningSent then
            speedWarningSent = true
            if notifySettings.solo.speedWarning then
                sendNotification("Flight Speed above 22 set! Risk of kick")
            end
        end
    else
        speedLabel.Text = "Flight Speed: " .. flySpeed
        speedWarningLabel.Text = ""
        speedWarningSent = false
    end

    sliderFill.Size = UDim2.new(scale, 0, 1, 0)
end

sliderBackground.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSlider = true
        dragging = false
        updateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSlider = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input)
    end
end)
