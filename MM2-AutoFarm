end

-- Створення платформи по центру workspace.Lobby + 100 студів вгору
local function createSafeZone()
    if not safeZonePart then
        local centerPosition = Vector3.new(0, 10000, 0)
        
        pcall(function()
            local lobbyModel = Workspace:FindFirstChild("Lobby")
            if lobbyModel and lobbyModel:IsA("Model") then
                local cf, size = lobbyModel:GetBoundingBox()
                centerPosition = cf.Position
            end
        end)

        safeZonePart = Instance.new("Part")
        safeZonePart.Shape = Enum.PartType.Cylinder
        safeZonePart.Size = Vector3.new(1, 50, 50)
        safeZonePart.Position = Vector3.new(centerPosition.X, centerPosition.Y + 100, centerPosition.Z)
        safeZonePart.Orientation = Vector3.new(0, 0, 90)
        safeZonePart.Anchored = true
        safeZonePart.BrickColor = BrickColor.new("Bright blue")
        safeZonePart.Material = Enum.Material.SmoothPlastic
        safeZonePart.Parent = Workspace
    end
end

local function getSafeZoneTeleportCFrame()
    if safeZonePart then
        return CFrame.new(safeZonePart.Position + Vector3.new(0, 2, 0))
    end
    return CFrame.new(0, 10102, 0)
end

